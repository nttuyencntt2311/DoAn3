<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F8FC"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#0F172A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Điều khoản &amp; Chính sách"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E2E8F0"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:cardBackgroundColor="#E2E8F0"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tabTerms"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#2563EB"
                    app:cardCornerRadius="11dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
                        <ImageView android:id="@+id/icTabTerms" android:layout_width="15dp" android:layout_height="15dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#FFFFFF"/>
                        <TextView android:id="@+id/tvTabTerms" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Điều khoản" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tabPrivacy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="11dp"
                    app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal">
                        <ImageView android:id="@+id/icTabPrivacy" android:layout_width="15dp" android:layout_height="15dp" android:src="@android:drawable/ic_lock_idle_lock" app:tint="#475569"/>
                        <TextView android:id="@+id/tvTabPrivacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Bảo mật" android:textColor="#475569" android:textSize="13sp" android:textStyle="bold" android:gravity="center"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:id="@+id/layoutTermsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="&quot;LexiVT&quot; đề cập đến nền tảng học tập trực tuyến, bao gồm ứng dụng di động và các dịch vụ đi kèm. &quot;Người dùng&quot; là bất kỳ cá nhân nào đăng ký tài khoản hoặc sử dụng dịch vụ của chúng tôi."
                            android:textColor="#334155"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#F1F5F9"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Quyền lợi người dùng" android:textColor="#2563EB" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="✓ Truy cập toàn bộ thư viện bài giảng và bài tập tương tác theo gói đăng ký." android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="✓ Tham gia các kỳ thi đánh giá năng lực và nhận chứng chỉ điện tử." android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="✓ Được bảo mật thông tin cá nhân và lịch sử học tập." android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="2. Trách nhiệm" android:textColor="#2563EB" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Người dùng có trách nhiệm bảo mật mật khẩu và thông tin đăng nhập. Mọi hành động vi phạm bản quyền nội dung (sao chép, phân phối trái phép) sẽ bị xử lý theo quy định của pháp luật hiện hành." android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="3. Thanh toán &amp; Hoàn tiền" android:textColor="#2563EB" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Các gói học phí được thanh toán trước qua các cổng thanh toán tích hợp. Chính sách hoàn tiền chỉ áp dụng trong vòng 7 ngày đầu tiên nếu người dùng chưa bắt đầu quá 10% nội dung khóa học." android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutPrivacyContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chúng tôi thu thập thông tin cá nhân như tên, email và tiến độ học tập để cá nhân hóa lộ trình AI cho riêng bạn."
                            android:textColor="#334155"
                            android:textSize="14sp"
                            android:lineSpacingExtra="4dp"/>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="16dp" android:background="#F1F5F9"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1. Sử dụng thông tin" android:textColor="#059669" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Thông tin được dùng để cải thiện chất lượng bài học, gửi thông báo nhắc nhở và hỗ trợ kỹ thuật." android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="2. Bảo mật dữ liệu" android:textColor="#059669" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Chúng tôi sử dụng các biện pháp mã hóa tiên tiến để bảo vệ dữ liệu của bạn khỏi các truy cập trái phép." android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="3. Chia sẻ với bên thứ ba" android:textColor="#059669" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="LexiVT cam kết không bán hoặc chia sẻ thông tin cá nhân của bạn cho bên thứ ba vì mục đích quảng cáo." android:textColor="#475569" android:textSize="13sp" android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Cập nhật lần cuối: 24 Tháng 05, 2026"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#DBEAFE"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cần hỗ trợ pháp lý?" android:textColor="#2563EB" android:textSize="13sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="legal@lexivt.com" android:textColor="#0F172A" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
