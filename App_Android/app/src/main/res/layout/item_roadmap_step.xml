<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/lineTop"
        android:layout_width="2dp"
        android:layout_height="32dp"
        android:background="#059669"
        app:layout_constraintEnd_toEndOf="@id/layoutIconOuter"
        app:layout_constraintStart_toStartOf="@id/layoutIconOuter"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/lineBottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#E2E8F0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/layoutIconOuter"
        app:layout_constraintStart_toStartOf="@id/layoutIconOuter"
        app:layout_constraintTop_toBottomOf="@id/layoutIconOuter" />

    <FrameLayout
        android:id="@+id/layoutIconOuter"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_blue"
        android:backgroundTint="#DBEAFE"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lineTop">

        <FrameLayout
            android:id="@+id/layoutIconInner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_blue"
            android:backgroundTint="#0A52CC">

            <ImageView
                android:id="@+id/ivStepIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_play" />
        </FrameLayout>
    </FrameLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#2563EB"
        app:strokeWidth="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/layoutIconOuter"
        app:layout_constraintTop_toTopOf="@id/layoutIconOuter">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="#2563EB"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/tvTag"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="GIAO TIẾP CƠ BẢN" />

            <TextView
                android:id="@+id/tvTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DBEAFE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="HIỆN TẠI"
                android:textColor="#1E40AF"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvStepDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="12dp"
                android:textColor="#64748B"
                android:textSize="12sp"
                app:layout_constraintEnd_toStartOf="@id/tvProgressText"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvStepTitle"
                tools:text="Tiến trình bài học &amp; giải thích XAI" />

            <TextView
                android:id="@+id/tvProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2563EB"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvStepDesc"
                tools:text="15 / 40 từ" />

            <ProgressBar
                android:id="@+id/progressStep"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:max="40"
                android:progress="0"
                android:progressBackgroundTint="#E2E8F0"
                android:progressTint="#2563EB"
                app:layout_constraintTop_toBottomOf="@id/tvStepDesc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueLearning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tiếp tục học ngay"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="14dp"
                app:layout_constraintTop_toBottomOf="@id/progressStep" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>