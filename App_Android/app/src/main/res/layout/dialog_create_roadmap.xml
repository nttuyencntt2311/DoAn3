<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <!-- Thanh kéo trang trí đầu BottomSheet -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#CBD5E1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khởi tạo Lộ trình AI 🚀"
            android:textAlignment="center"
            android:textColor="#0F172A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Điền thông tin để LexiVT AI thiết kế lộ trình học dành riêng cho bạn."
            android:textAlignment="center"
            android:textColor="#64748B"
            android:textSize="13.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mục tiêu chính"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="10dp">
            <Spinner
                android:id="@+id/spinnerGoal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="#0F172A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.9"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trình độ hiện tại"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="4dp">
                    <Spinner
                        android:id="@+id/spinnerLevel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.1"
                android:orientation="vertical"
                android:layout_marginStart="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thời gian học/ngày"
                    android:textColor="#334155"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="4dp">
                    <Spinner
                        android:id="@+id/spinnerTime"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mong muốn cụ thể của bạn (Không bắt buộc)"
            android:textColor="#334155"
            android:textSize="13sp"
            android:textStyle="bold" />
        <EditText
            android:id="@+id/edtExpectation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:gravity="top|start"
            android:hint="VD: Mình muốn học để tháng sau phỏng vấn xin việc, trọng tâm là từ vựng IT..."
            android:minLines="3"
            android:padding="12dp"
            android:textColor="#0F172A"
            android:textColorHint="#94A3B8"
            android:textSize="13.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerate"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Phân tích &amp; Khởi tạo lộ trình"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold"
            app:backgroundTint="#2563EB"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_robot"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

    </LinearLayout>
</ScrollView>
